{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegoami/newscollection2027/contract/analysis.schema.json",
  "title": "Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster_id", "cluster_version", "backend", "model", "generated_at", "headline", "summary", "claims", "discrepancies", "agreement"],
  "properties": {
    "cluster_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"},
    "cluster_version": {"type": "integer", "minimum": 1},
    "backend": {"type": "string", "enum": ["api", "claude_code"]},
    "model": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^c\\d{1,2}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 300},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quote"}}
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "severity", "explanation", "quotes"],
        "properties": {
          "kind": {"type": "string", "enum": ["contradiction", "number", "attribution", "framing", "omission"]},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^c\\d{1,2}$"}},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 300},
          "quotes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/quote"}}
        }
      }
    },
    "agreement": {"type": "string", "enum": ["full", "partial", "conflicting"]},
    "notes": {"type": "string", "maxLength": 500}
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outlet", "item_id", "quote"],
      "properties": {
        "outlet": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "quote": {"type": "string", "minLength": 3, "maxLength": 400}
      }
    }
  }
}
